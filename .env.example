# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=livecomerce
POSTGRES_USER=livecomerce
POSTGRES_PASSWORD=change-me

# Used by the Spring app (override host for remote DBs)
DB_URL=jdbc:postgresql://localhost:5432/livecomerce
DB_USERNAME=livecomerce
DB_PASSWORD=change-me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-char-random-secret
JWT_EXPIRATION_MS=86400000

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_API_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_PRO=price_
STRIPE_PRICE_AGENCY=price_

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_
RESEND_FROM_ADDRESS=noreply@livecomerce.com

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BILLING_SUCCESS_URL=http://localhost:3000/billing/success
BILLING_CANCEL_URL=http://localhost:3000/billing/cancel

# ── Misc ──────────────────────────────────────────────────────────────────────
OAUTH2_CODE_TTL_SECONDS=90
KAFKA_SERVERS=localhost:9092

# ── Cokies ──────────────────────────────────────────────────────────────────────
COOKIE_SECURE
COOKIE_SAME_SITE

#AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=